{
  "manifest_version": 3,
  "name": "KC Live",
  "version": "1.0",
  "description": "Ouvre KC Live (scores de la Karmine Corp) dans une fenêtre d'appli.",
  "action": {
    "default_title": "Ouvrir KC Live",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}